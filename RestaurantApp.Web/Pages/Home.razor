@page "/"

<PageTitle>RestaurantApp</PageTitle>

<h1>RestaurantApp</h1>

<p class="lead">A lightweight restaurant ERP — weekly menus, recipes, staff planning and inventory.</p>

<div class="row g-4 mt-2">
    <div class="col-sm-6 col-lg-3">
        <a class="card h-100 text-decoration-none text-reset home-card" href="menus">
            <div class="card-body">
                <div class="home-card-icon">🍽️</div>
                <h5 class="card-title">Menu</h5>
                <p class="card-text text-muted">Plan weekly menus, load recipes onto days, and export an A4 PDF.</p>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a class="card h-100 text-decoration-none text-reset home-card" href="recipes">
            <div class="card-body">
                <div class="home-card-icon">📖</div>
                <h5 class="card-title">Recipes</h5>
                <p class="card-text text-muted">Build recipes from inventory ingredients; allergens roll up automatically.</p>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a class="card h-100 text-decoration-none text-reset home-card" href="planning">
            <div class="card-body">
                <div class="home-card-icon">📅</div>
                <h5 class="card-title">Planning</h5>
                <p class="card-text text-muted">Schedule cooks and clerks, with hours, labour cost and overtime alerts.</p>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a class="card h-100 text-decoration-none text-reset home-card" href="inventory">
            <div class="card-body">
                <div class="home-card-icon">📦</div>
                <h5 class="card-title">Inventaire</h5>
                <p class="card-text text-muted">Track ingredients, quantities and allergens, with low-stock alerts.</p>
            </div>
        </a>
    </div>
</div>
