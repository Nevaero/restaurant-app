@page "/"

<PageTitle>RestaurantApp</PageTitle>

<h1>RestaurantApp</h1>

<p class="lead">A small corporate-restaurant management demo built with ASP.NET Core 8 and Blazor WebAssembly.</p>

<div class="row g-3 mt-2">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Menus</h5>
                <p class="card-text">Create daily menus, assign dishes and ingredients, and serve a menu to deduct stock.</p>
                <a class="btn btn-primary" href="menus">Go to Menus</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Stock</h5>
                <p class="card-text">Track ingredient stock levels and adjust quantities. Low-stock items are highlighted.</p>
                <a class="btn btn-primary" href="stock">Go to Stock</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Planning</h5>
                <p class="card-text">View the weekly staff schedule and assign shifts to employees.</p>
                <a class="btn btn-primary" href="planning">Go to Planning</a>
            </div>
        </div>
    </div>
</div>
