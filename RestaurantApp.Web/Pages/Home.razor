@page "/"
@inject LocalizationService Loc

<PageTitle>RestaurantApp</PageTitle>

<h1>RestaurantApp</h1>

<p class="lead">@Loc["app.tagline"]</p>

<div class="row g-4 mt-2">
    <div class="col-sm-6 col-lg-3">
        <a class="card h-100 text-decoration-none text-reset home-card" href="menus">
            <div class="card-body">
                <div class="home-card-icon">🍽️</div>
                <h5 class="card-title">@Loc["nav.menu"]</h5>
                <p class="card-text text-muted">@Loc["home.menu.desc"]</p>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a class="card h-100 text-decoration-none text-reset home-card" href="recipes">
            <div class="card-body">
                <div class="home-card-icon">📖</div>
                <h5 class="card-title">@Loc["nav.recipes"]</h5>
                <p class="card-text text-muted">@Loc["home.recipes.desc"]</p>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a class="card h-100 text-decoration-none text-reset home-card" href="planning">
            <div class="card-body">
                <div class="home-card-icon">📅</div>
                <h5 class="card-title">@Loc["nav.planning"]</h5>
                <p class="card-text text-muted">@Loc["home.planning.desc"]</p>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a class="card h-100 text-decoration-none text-reset home-card" href="inventory">
            <div class="card-body">
                <div class="home-card-icon">📦</div>
                <h5 class="card-title">@Loc["nav.inventory"]</h5>
                <p class="card-text text-muted">@Loc["home.inventory.desc"]</p>
            </div>
        </a>
    </div>
</div>
