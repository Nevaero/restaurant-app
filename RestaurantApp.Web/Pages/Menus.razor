@page "/menus"
@inject ApiClient Api
@inject NavigationManager Nav
@inject LocalizationService Loc

<PageTitle>@Loc["nav.menu"]</PageTitle>

<h1>@Loc["menus.title"]</h1>

@if (loading)
{
    <p><em>@Loc["common.loading"]</em></p>
}
else if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else
{
    <div class="d-flex justify-content-end mb-3">
        <button class="btn btn-success" @onclick="ShowCreateForm">@Loc["menus.new"]</button>
    </div>

    @if (menus.Count == 0)
    {
        <p class="text-muted">@Loc["menus.empty"]</p>
    }
    else
    {
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>@Loc["menus.weekOf"]</th>
                    <th>@Loc["common.name"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var menu in menus)
                {
                    <tr>
                        <td>@menu.WeekStart.ToString("dd MMM yyyy")</td>
                        <td>@menu.Name</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" href="menus/@menu.Id">@Loc["common.open"]</a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteMenu(menu)">@Loc["common.delete"]</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@* Create-menu modal *@
@if (showCreate)
{
    <div class="modal-backdrop-custom">
        <div class="card shadow modal-card">
            <div class="card-body">
                <h5 class="card-title">@Loc["menus.newMenu"]</h5>
                <div class="mb-2">
                    <label class="form-label">@Loc["common.name"]</label>
                    <input class="form-control" @bind="newName" />
                </div>
                <div class="mb-2">
                    <label class="form-label">@Loc["menus.weekStarting"]</label>
                    <input type="date" class="form-control" @bind="newMonday" />
                    <div class="form-text">@Loc["menus.snapHint"]</div>
                </div>
                @if (createError is not null)
                {
                    <div class="alert alert-danger py-1">@createError</div>
                }
                <div class="d-flex justify-content-end gap-2">
                    <button class="btn btn-secondary" @onclick="() => showCreate = false">@Loc["common.cancel"]</button>
                    <button class="btn btn-success" @onclick="SaveNew">@Loc["menus.createEdit"]</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<MenuSummaryDto> menus = [];
    private bool loading = true;
    private string? error;

    private bool showCreate;
    private string newName = string.Empty;
    private DateTime newMonday = DateTime.Today;
    private string? createError;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try
        {
            menus = await Api.GetMenusAsync();
        }
        catch (Exception ex)
        {
            error = $"Could not load menus: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void ShowCreateForm()
    {
        newName = string.Empty;
        newMonday = DateTime.Today;
        createError = null;
        showCreate = true;
    }

    private async Task SaveNew()
    {
        if (string.IsNullOrWhiteSpace(newName))
        {
            createError = Loc["common.nameRequired"];
            return;
        }

        var created = await Api.CreateMenuAsync(new CreateMenuRequest(newName, DateOnly.FromDateTime(newMonday)));
        showCreate = false;
        if (created is not null)
            Nav.NavigateTo($"menus/{created.Id}");
        else
            await LoadAsync();
    }

    private async Task DeleteMenu(MenuSummaryDto menu)
    {
        await Api.DeleteMenuAsync(menu.Id);
        await LoadAsync();
    }
}
