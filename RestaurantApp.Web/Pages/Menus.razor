@page "/menus"
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>Menu</PageTitle>

<h1>Weekly Menus</h1>

@if (loading)
{
    <p><em>Loading…</em></p>
}
else if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else
{
    <div class="d-flex justify-content-end mb-3">
        <button class="btn btn-success" @onclick="ShowCreateForm">+ New menu</button>
    </div>

    @if (menus.Count == 0)
    {
        <p class="text-muted">No menus yet. Create one to get started.</p>
    }
    else
    {
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Week of (Monday)</th>
                    <th>Name</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var menu in menus)
                {
                    <tr>
                        <td>@menu.WeekStart.ToString("dd MMM yyyy")</td>
                        <td>@menu.Name</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" href="menus/@menu.Id">Open</a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteMenu(menu)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@* Create-menu modal *@
@if (showCreate)
{
    <div class="modal-backdrop-custom">
        <div class="card shadow modal-card">
            <div class="card-body">
                <h5 class="card-title">New menu</h5>
                <div class="mb-2">
                    <label class="form-label">Name</label>
                    <input class="form-control" @bind="newName" placeholder="e.g. Spring lunch menu" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Week starting (Monday)</label>
                    <input type="date" class="form-control" @bind="newMonday" />
                    <div class="form-text">Any date you pick is snapped to that week's Monday.</div>
                </div>
                @if (createError is not null)
                {
                    <div class="alert alert-danger py-1">@createError</div>
                }
                <div class="d-flex justify-content-end gap-2">
                    <button class="btn btn-secondary" @onclick="() => showCreate = false">Cancel</button>
                    <button class="btn btn-success" @onclick="SaveNew">Create &amp; edit</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<MenuSummaryDto> menus = [];
    private bool loading = true;
    private string? error;

    private bool showCreate;
    private string newName = string.Empty;
    private DateTime newMonday = DateTime.Today;
    private string? createError;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try
        {
            menus = await Api.GetMenusAsync();
        }
        catch (Exception ex)
        {
            error = $"Could not load menus: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void ShowCreateForm()
    {
        newName = string.Empty;
        newMonday = DateTime.Today;
        createError = null;
        showCreate = true;
    }

    private async Task SaveNew()
    {
        if (string.IsNullOrWhiteSpace(newName))
        {
            createError = "Name is required.";
            return;
        }

        var created = await Api.CreateMenuAsync(new CreateMenuRequest(newName, DateOnly.FromDateTime(newMonday)));
        showCreate = false;
        if (created is not null)
            Nav.NavigateTo($"menus/{created.Id}");
        else
            await LoadAsync();
    }

    private async Task DeleteMenu(MenuSummaryDto menu)
    {
        await Api.DeleteMenuAsync(menu.Id);
        await LoadAsync();
    }
}
