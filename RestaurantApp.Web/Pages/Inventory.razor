@page "/inventory"
@inject ApiClient Api

<PageTitle>Inventaire</PageTitle>

<h1>Inventaire</h1>

@if (loading)
{
    <p><em>Loading…</em></p>
}
else if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="text-muted">@items.Count item(s), @items.Count(i => i.IsLow) low on stock</span>
        <button class="btn btn-success" @onclick="ShowAddForm">+ Add item</button>
    </div>

    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th class="text-end">Quantity</th>
                <th>Unit</th>
                <th class="text-end">Low-stock threshold</th>
                <th>Allergens</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in items)
            {
                <tr class="@(item.IsLow ? "table-warning" : null)">
                    <td>@item.Name</td>
                    <td class="text-end">@item.Quantity</td>
                    <td>@item.Unit</td>
                    <td class="text-end">@item.LowStockThreshold</td>
                    <td>
                        @foreach (var a in SplitAllergens(item.Allergens))
                        {
                            <span class="badge bg-info text-dark me-1">@a</span>
                        }
                    </td>
                    <td>
                        @if (item.IsLow)
                        {
                            <span class="badge bg-danger">Low</span>
                        }
                        else
                        {
                            <span class="badge bg-success">OK</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowEdit(item)">Edit</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(item)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (showForm)
{
    <div class="modal-backdrop-custom">
        <div class="card shadow modal-card">
            <div class="card-body">
                <h5 class="card-title">@(editId is null ? "Add item" : "Edit item")</h5>
                <div class="mb-2">
                    <label class="form-label">Name</label>
                    <input class="form-control" @bind="fName" />
                </div>
                <div class="row">
                    <div class="col mb-2">
                        <label class="form-label">Quantity</label>
                        <input type="number" step="0.001" class="form-control" @bind="fQuantity" />
                    </div>
                    <div class="col mb-2">
                        <label class="form-label">Unit</label>
                        <input class="form-control" @bind="fUnit" placeholder="kg" />
                    </div>
                    <div class="col mb-2">
                        <label class="form-label">Low-stock threshold</label>
                        <input type="number" step="0.001" class="form-control" @bind="fThreshold" />
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label">Allergens</label>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var allergen in AllAllergens)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="al-@allergen"
                                       checked="@fAllergens.Contains(allergen)"
                                       @onchange="e => ToggleAllergen(allergen, (bool)e.Value!)" />
                                <label class="form-check-label" for="al-@allergen">@allergen</label>
                            </div>
                        }
                    </div>
                </div>
                @if (formError is not null)
                {
                    <div class="alert alert-danger py-1">@formError</div>
                }
                <div class="d-flex justify-content-end gap-2">
                    <button class="btn btn-secondary" @onclick="() => showForm = false">Cancel</button>
                    <button class="btn btn-success" @onclick="SaveAsync">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // The EU's 14 major food allergens.
    private static readonly string[] AllAllergens =
    [
        "Gluten", "Crustaceans", "Eggs", "Fish", "Peanuts", "Soybeans", "Milk",
        "Nuts", "Celery", "Mustard", "Sesame", "Sulphites", "Lupin", "Molluscs"
    ];

    private List<IngredientDto> items = [];
    private bool loading = true;
    private string? error;

    private bool showForm;
    private int? editId;
    private string fName = string.Empty;
    private decimal fQuantity;
    private string fUnit = "kg";
    private decimal fThreshold;
    private readonly HashSet<string> fAllergens = [];
    private string? formError;

    protected override Task OnInitializedAsync() => LoadAsync();

    private static IEnumerable<string> SplitAllergens(string allergens) =>
        allergens.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try
        {
            items = await Api.GetIngredientsAsync();
        }
        catch (Exception ex)
        {
            error = $"Could not load inventory: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void ToggleAllergen(string allergen, bool isChecked)
    {
        if (isChecked) fAllergens.Add(allergen);
        else fAllergens.Remove(allergen);
    }

    private void ShowAddForm()
    {
        editId = null;
        fName = string.Empty;
        fQuantity = 0;
        fUnit = "kg";
        fThreshold = 0;
        fAllergens.Clear();
        formError = null;
        showForm = true;
    }

    private void ShowEdit(IngredientDto item)
    {
        editId = item.Id;
        fName = item.Name;
        fQuantity = item.Quantity;
        fUnit = item.Unit;
        fThreshold = item.LowStockThreshold;
        fAllergens.Clear();
        foreach (var a in SplitAllergens(item.Allergens))
            fAllergens.Add(a);
        formError = null;
        showForm = true;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(fName))
        {
            formError = "Name is required.";
            return;
        }

        var allergens = string.Join(",", AllAllergens.Where(fAllergens.Contains));

        if (editId is null)
            await Api.CreateIngredientAsync(new CreateIngredientRequest(fName, fQuantity, fUnit, fThreshold, allergens));
        else
            await Api.UpdateIngredientAsync(editId.Value, new UpdateIngredientRequest(fName, fQuantity, fUnit, fThreshold, allergens));

        showForm = false;
        await LoadAsync();
    }

    private async Task Delete(IngredientDto item)
    {
        await Api.DeleteIngredientAsync(item.Id);
        await LoadAsync();
    }
}
