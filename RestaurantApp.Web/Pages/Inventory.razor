@page "/inventory"
@inject ApiClient Api
@inject LocalizationService Loc

<PageTitle>@Loc["inventory.title"]</PageTitle>

<h1>@Loc["inventory.title"]</h1>

@if (loading)
{
    <p><em>@Loc["common.loading"]</em></p>
}
else if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="text-muted">@items.Count @Loc["inventory.summary"], @items.Count(i => i.IsLow) @Loc["inventory.lowCount"]</span>
        <button class="btn btn-success" @onclick="ShowAddForm">@Loc["inventory.addItem"]</button>
    </div>

    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>@Loc["common.name"]</th>
                <th class="text-end">@Loc["inventory.quantity"]</th>
                <th>@Loc["inventory.unit"]</th>
                <th class="text-end">@Loc["inventory.threshold"]</th>
                <th>@Loc["inventory.allergens"]</th>
                <th>@Loc["common.status"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in items)
            {
                <tr class="@(item.IsLow ? "table-warning" : null)">
                    <td>@item.Name</td>
                    <td class="text-end">@item.Quantity</td>
                    <td>@item.Unit</td>
                    <td class="text-end">@item.LowStockThreshold</td>
                    <td>
                        @foreach (var a in item.Allergens)
                        {
                            <span class="badge bg-info text-dark me-1">@a.Name</span>
                        }
                    </td>
                    <td>
                        @if (item.IsLow)
                        {
                            <span class="badge bg-danger">@Loc["inventory.low"]</span>
                        }
                        else
                        {
                            <span class="badge bg-success">@Loc["inventory.ok"]</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowEdit(item)">@Loc["common.edit"]</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(item)">@Loc["common.delete"]</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (showForm)
{
    <div class="modal-backdrop-custom">
        <div class="card shadow modal-card">
            <div class="card-body">
                <h5 class="card-title">@(editId is null ? Loc["inventory.addTitle"] : Loc["inventory.editTitle"])</h5>
                <div class="mb-2">
                    <label class="form-label">@Loc["common.name"]</label>
                    <input class="form-control" @bind="fName" />
                </div>
                <div class="row">
                    <div class="col mb-2">
                        <label class="form-label">@Loc["inventory.quantity"]</label>
                        <input type="number" step="0.001" class="form-control" @bind="fQuantity" />
                    </div>
                    <div class="col mb-2">
                        <label class="form-label">@Loc["inventory.unit"]</label>
                        <input class="form-control" @bind="fUnit" placeholder="kg" />
                    </div>
                    <div class="col mb-2">
                        <label class="form-label">@Loc["inventory.threshold"]</label>
                        <input type="number" step="0.001" class="form-control" @bind="fThreshold" />
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label">@Loc["inventory.allergens"]</label>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var allergen in allAllergens)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="al-@allergen.Id"
                                       checked="@fAllergenIds.Contains(allergen.Id)"
                                       @onchange="e => ToggleAllergen(allergen.Id, (bool)e.Value!)" />
                                <label class="form-check-label" for="al-@allergen.Id">@allergen.Name</label>
                            </div>
                        }
                    </div>
                </div>
                @if (formError is not null)
                {
                    <div class="alert alert-danger py-1">@formError</div>
                }
                <div class="d-flex justify-content-end gap-2">
                    <button class="btn btn-secondary" @onclick="() => showForm = false">@Loc["common.cancel"]</button>
                    <button class="btn btn-success" @onclick="SaveAsync">@Loc["common.save"]</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<IngredientDto> items = [];
    private List<AllergenDto> allAllergens = [];
    private bool loading = true;
    private string? error;

    private bool showForm;
    private int? editId;
    private string fName = string.Empty;
    private decimal fQuantity;
    private string fUnit = "kg";
    private decimal fThreshold;
    private readonly HashSet<int> fAllergenIds = [];
    private string? formError;

    protected override async Task OnInitializedAsync()
    {
        allAllergens = await Api.GetAllergensAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try
        {
            items = await Api.GetIngredientsAsync();
        }
        catch (Exception ex)
        {
            error = $"Could not load inventory: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void ToggleAllergen(int id, bool isChecked)
    {
        if (isChecked) fAllergenIds.Add(id);
        else fAllergenIds.Remove(id);
    }

    private void ShowAddForm()
    {
        editId = null;
        fName = string.Empty;
        fQuantity = 0;
        fUnit = "kg";
        fThreshold = 0;
        fAllergenIds.Clear();
        formError = null;
        showForm = true;
    }

    private void ShowEdit(IngredientDto item)
    {
        editId = item.Id;
        fName = item.Name;
        fQuantity = item.Quantity;
        fUnit = item.Unit;
        fThreshold = item.LowStockThreshold;
        fAllergenIds.Clear();
        foreach (var a in item.Allergens)
            fAllergenIds.Add(a.Id);
        formError = null;
        showForm = true;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(fName))
        {
            formError = Loc["common.nameRequired"];
            return;
        }

        var ids = fAllergenIds.ToList();
        if (editId is null)
            await Api.CreateIngredientAsync(new CreateIngredientRequest(fName, fQuantity, fUnit, fThreshold, ids));
        else
            await Api.UpdateIngredientAsync(editId.Value, new UpdateIngredientRequest(fName, fQuantity, fUnit, fThreshold, ids));

        showForm = false;
        await LoadAsync();
    }

    private async Task Delete(IngredientDto item)
    {
        await Api.DeleteIngredientAsync(item.Id);
        await LoadAsync();
    }
}
